# provenance-tg-bot config — copy to config.env and fill in (chmod 600)
# Bot token from @BotFather:
BOT_TOKEN=
# Authorized chat IDs, comma-separated. Get yours by sending /id to the bot.
ALLOWED_CHAT_IDS=
# Tendermint/CometBFT RPC of the node:
RPC_URL=http://localhost:26657
# Node home dir (for `provenanced query`):
HOME_DIR=/home/provenance/.provenanced
# Your validator consensus address (valcons). Find it with:
#   provenanced keys parse <HEX_FROM_status_validator_info_address>
VALCONS=
# Background check interval, seconds:
CHECK_INTERVAL=60
# Missed-blocks thresholds (compared against the slashing signed_blocks_window):
MISSED_WARN=500
MISSED_CRIT=1500
# Minimum peers before warning:
PEERS_MIN=3
# Block-lag warning threshold, seconds:
BLOCK_LAG_WARN_SEC=30
# Disk / usage warning threshold, percent:
DISK_WARN_PCT=85
